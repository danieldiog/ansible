#!/bin/bash

#
# Localizacao da instancia do apache
#

HTTP_SERVICO_INFRA="{{ servico | trim }}"
HTTP_SERVER_ROOT="/web/shared/servers/${HTTP_SERVICO_INFRA}"
HTTP_LISTEN_ADDRESS="*"
export HTTP_SERVICO_INFRA HTTP_SERVER_ROOT HTTP_LISTEN_ADDRESS

#
# PidFile
#

HTTP_SERVER_NAME=hostname -s
HTTP_PID_FILE="${HTTP_SERVER_ROOT}/pids/httpd_${HTTP_SERVER_NAME}_${HTTP_SERVICO_INFRA}.pid"
HTTP_CHECKRESTART_PID_FILE="${HTTP_SERVER_ROOT}/pids/childs_${hostname}.pid"
export HTTP_SERVER_NAME HTTP_PID_FILE HTTP_CHECKRESTART_PID_FILE

#
# Comandos
#
CMD_HTTPD=/web/shared/servers/${HTTP_SERVICO_INFRA}/httpd
export CMD_HTTPD
COMMAND_CAT="/bin/cat"
export COMMAND_CAT

#
# Parametros
#

HTTP_ARGUMENTS="-DSSL"
export HTTP_ARGUMENTS